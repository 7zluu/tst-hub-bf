                corner(valBox, 4)
                local bar = new("Frame", {
                    BackgroundColor3=Theme.Colors.BorderLight, BorderSizePixel=0,
                    Position=UDim2.new(0, 12, 0, 36),
                    Size=UDim2.new(1, -24, 0, 4), Parent=wrap
                })
                corner(bar, 2)
                local fill = new("Frame", {
                    BackgroundColor3=Color3.fromRGB(255,255,255), BorderSizePixel=0,
                    Size=UDim2.new((default - mn) / (mx - mn), 0, 1, 0), Parent=bar
                })
                corner(fill, 2)
                local hit = new("TextButton", {
                    BackgroundTransparency=1,
                    Size=UDim2.new(1, 0, 4, 0),
                    Position=UDim2.new(0, 0, 0.5, 0),
                    AnchorPoint=Vector2.new(0, 0.5), Text="", Parent=bar
                })
                local function apply(v, call)
                    v = math.clamp(v, mn, mx)
                    if rounding then v = tonumber(string.format("%." .. rounding .. "f", v)) else v = math.floor(v) end
                    value = v
                    valBox.Text = tostring(v)
                    tween(fill, 0.08, {Size = UDim2.new((v - mn) / (mx - mn), 0, 1, 0)})
                    if call and cb then
                        local ok, err = pcall(cb, v)
                        if not ok then warn("[Ousaware] Slider error: " .. tostring(err)) end
                    end
                end
                local dragging = false
                hit.MouseButton1Down:Connect(function() dragging = true end)
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)
                UIS.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local pct = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                        apply(mn + (mx - mn) * pct, true)
                    end
                end)
                valBox.FocusLost:Connect(function() apply(tonumber(valBox.Text) or value, true) end)
                return {SetValue = function(_, v) apply(v, true) end}
            end

            function g:AddDropdown(id, opt)
                opt = opt or {}
                local text = opt.Text or opt.Title or "Dropdown"
                local values = opt.Values or {}
                local multi = opt.Multi == true
                local cb = opt.Callback
                local default = opt.Default
                local sel = {}
                if multi then
                    if type(default) == "table" then
                        for k, v in pairs(default) do if v == true then sel[k] = true end end
                    end
                else
                    if type(default) == "number" then sel[values[default] or values[1]] = true
                    elseif type(default) == "string" then sel[default] = true
                    else sel[values[1]] = true end
                end
                local wrap = new("Frame", {
                    BackgroundColor3=Theme.Colors.Input, BorderSizePixel=0,
                    Size=UDim2.new(1, 0, 0, 34), ClipsDescendants=true, Parent=gb
                })
                corner(wrap, 6); stroke(wrap)
                local head = new("TextButton", {BackgroundTransparency=1, Size=UDim2.new(1,0,0,34), Text="", Parent=wrap})
                local arrow = new("ImageLabel", {
                    BackgroundTransparency=1,
                    Image="rbxassetid://6954383209", ImageColor3=Theme.Colors.Text2,
                    AnchorPoint=Vector2.new(1, 0.5),
                    Position=UDim2.new(1, -12, 0, 17),
                    Size=UDim2.new(0, 10, 0, 10), Parent=wrap
                })
                local function getText()
                    if multi then
                        local t = {}
                        for k, v in pairs(sel) do if v then table.insert(t, k) end end
                        return text .. ": " .. (#t > 0 and table.concat(t, ", ") or "None")
                    end
                    for k, v in pairs(sel) do if v then return text .. ": " .. k end end
                    return text .. ": None"
                end
                local lbl = new("TextLabel", {
                    BackgroundTransparency=1, Font=Theme.Font, Text=getText(),
                    TextColor3=Theme.Colors.Text, TextSize=13,
                    TextXAlignment=Enum.TextXAlignment.Left,
                    Position=UDim2.new(0, 12, 0, 0),
                    Size=UDim2.new(1, -32, 0, 34), Parent=wrap
                })
                local list = new("Frame", {
                    BackgroundTransparency=1,
                    Position=UDim2.new(0, 4, 0, 34),
                    Size=UDim2.new(1, -8, 0, 0), Parent=wrap
                })
                new("UIListLayout", {SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0, 2), Parent=list})
                local opened = false
                local function refresh()
                    for _, c in ipairs(list:GetChildren()) do
                        if not c:IsA("UIListLayout") then c:Destroy() end
                    end
                    for i, v in ipairs(values) do
                        local item = new("TextButton", {
                            BackgroundColor3 = sel[v] and Color3.fromRGB(255,255,255) or Theme.Colors.Card,
                            BorderSizePixel=0, Font=Theme.Font, Text=tostring(v),
                            TextColor3 = sel[v] and Color3.fromRGB(0,0,0) or Theme.Colors.Text,
                            TextSize=12,
                            TextXAlignment=Enum.TextXAlignment.Left,
                            Size=UDim2.new(1, 0, 0, 26),
                            LayoutOrder=i, AutoButtonColor=false, Parent=list
                        })
                        corner(item, 4)
                        new("UIPadding", {PaddingLeft=UDim.new(0, 8), Parent=item})
                        item.MouseButton1Click:Connect(function()
                            if multi then
                                sel[v] = not sel[v] or nil
                                lbl.Text = getText()
                                if cb then pcall(cb, v, sel[v] == true) end
                                refresh()
                            else
                                for k in pairs(sel) do sel[k] = nil end
                                sel[v] = true
                                lbl.Text = getText()
                                opened = false
                                tween(wrap, 0.2, {Size = UDim2.new(1, 0, 0, 34)})
                                tween(arrow, 0.2, {Rotation = 0})
                                if cb then pcall(cb, v) end
                                refresh()
                            end
                        end)
                    end
                end
                refresh()
                head.MouseButton1Click:Connect(function()
                    opened = not opened
                    local h = math.min(#values * 28 + 4, 180)
                    tween(wrap, 0.2, {Size = UDim2.new(1, 0, 0, opened and (34 + h) or 34)})
                    tween(arrow, 0.2, {Rotation = opened and 180 or 0})
                end)
                return {
                    GetValue = function()
                        if multi then
                            local r = {}
                            for k, v in pairs(sel) do if v then table.insert(r, k) end end
                            return r
                        end
                        for k, v in pairs(sel) do if v then return k end end
                    end,
                    SetValue = function(_, v)
                        if multi then
                            for k in pairs(sel) do sel[k] = nil end
                            if type(v) == "table" then
                                for k2, v2 in pairs(v) do if v2 == true then sel[k2] = true end end
                            end
                        else
                            for k in pairs(sel) do sel[k] = nil end
                            sel[v] = true
                        end
                        lbl.Text = getText(); refresh()
                    end,
                    ClearText = function(_, t) lbl.Text = text .. ": " .. tostring(t or "") end
                }
            end

            function g:AddInput(id, opt)
                opt = opt or {}
                local text = opt.Text or opt.Title or "Input"
                local placeholder = opt.Placeholder or ""
                local default = opt.Default or ""
                local cb = opt.Callback
                local wrap = new("Frame", {
                    BackgroundColor3=Theme.Colors.Input, BorderSizePixel=0,
                    Size=UDim2.new(1, 0, 0, 58), Parent=gb
                })
                corner(wrap, 6); stroke(wrap)
                new("TextLabel", {
                    BackgroundTransparency=1, Font=Theme.Font, Text=tostring(text),
                    TextColor3=Theme.Colors.Text, TextSize=13,
                    TextXAlignment=Enum.TextXAlignment.Left,
                    Position=UDim2.new(0, 12, 0, 8), Size=UDim2.new(1, -24, 0, 16), Parent=wrap
                })
                local box = new("TextBox", {
                    BackgroundColor3=Theme.Colors.Card, BorderSizePixel=0,
                    Font=Theme.Font, PlaceholderText=placeholder,
                    PlaceholderColor3=Theme.Colors.Text3,
                    Text=default, TextColor3=Theme.Colors.Text, TextSize=12,
                    TextXAlignment=Enum.TextXAlignment.Left,
                    Position=UDim2.new(0, 12, 0, 28),
                    Size=UDim2.new(1, -24, 0, 22),
                    ClearTextOnFocus=false, Parent=wrap
                })
                corner(box, 4)
                new("UIPadding", {PaddingLeft=UDim.new(0, 8), Parent=box})
                box.FocusLost:Connect(function() if cb then pcall(cb, box.Text) end end)
                return {SetValue = function(_, v) box.Text = v; if cb then pcall(cb, v) end end}
            end

            return g
        end

        function tab:AddLeftGroupbox(name) return groupMethods(makeGroup(name)) end
        function tab:AddRightGroupbox(name) return tab:AddLeftGroupbox(name) end
        function tab:BuildThemeSection() return groupMethods(makeGroup("Theme")) end
        function tab:BuildConfigSection() return groupMethods(makeGroup("Config")) end

        return tab
    end

    -- ═══ FLOATING TOGGLE (X blanca fondo negro) ═══
    local toggleGui = new("ScreenGui", {Name="OusawareToggle", ResetOnSpawn=false, ZIndexBehavior=Enum.ZIndexBehavior.Sibling, Parent=p})
    local toggle = new("TextButton", {
        BackgroundColor3=Color3.fromRGB(0,0,0), BorderSizePixel=0,
        Font=Theme.Font, Text="X", TextColor3=Color3.fromRGB(255,255,255),
        TextSize=18, AnchorPoint=Vector2.new(0, 1),
        Position=UDim2.new(0, 20, 1, -20),
        Size=UDim2.new(0, 44, 0, 44),
        AutoButtonColor=false, Parent=toggleGui
    })
    corner(toggle, 22)
    stroke(toggle, Color3.fromRGB(255,255,255), 1.5)
    makeDraggable(toggle, toggle)
    toggle.MouseButton1Click:Connect(function()
        lib.UIEnabled = not lib.UIEnabled
        gui.Enabled = lib.UIEnabled
    end)

    lib.Window = window
    return window
end

function lib.ToggleUI()
    if lib.Gui then
        lib.UIEnabled = not lib.UIEnabled
        lib.Gui.Enabled = lib.UIEnabled
    end
end

