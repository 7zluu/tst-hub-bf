function lib:Notify(opt)
    opt = opt or {}
    local frame = new("Frame", {
        BackgroundColor3 = Theme.Colors.Card,
        Size = UDim2.new(1, 0, 0, 66),
        Parent = notifContainer, ClipsDescendants = true
    })
    corner(frame)
    stroke(frame, Theme.Colors.BorderLight)
    new("Frame", {
        BackgroundColor3 = Theme.Colors.Text,
        Size = UDim2.new(0, 3, 1, -20),
        Position = UDim2.new(0, 8, 0, 10),
        BorderSizePixel = 0, Parent = frame
    })
    new("TextLabel", {
        BackgroundTransparency=1, Font=Theme.Font, Text=opt.Title or "Ousaware Hub",
        TextColor3=Theme.Colors.Text, TextSize=14, TextXAlignment=Enum.TextXAlignment.Left,
        Position=UDim2.new(0, 20, 0, 10), Size=UDim2.new(1, -30, 0, 18), Parent=frame
    })
    new("TextLabel", {
        BackgroundTransparency=1, Font=Theme.Font, Text=opt.Description or opt.Content or "",
        TextColor3=Theme.Colors.Text2, TextSize=12, TextWrapped=true,
        TextXAlignment=Enum.TextXAlignment.Left,
        Position=UDim2.new(0, 20, 0, 30), Size=UDim2.new(1, -30, 1, -36), Parent=frame
    })
    local duration = opt.Duration or 4
    task.delay(duration, function()
        tween(frame, 0.25, {BackgroundTransparency=1}):Play()
        task.wait(0.3)
        frame:Destroy()
    end)
end

