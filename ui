        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.new(0, 20, 0, 30),
        Size = UDim2.new(1, -30, 1, -36),
        Parent = frame,
    })
    frame.Position = UDim2.new(1, 340, 0, 0)
    tween(frame, 0.25, {Position = UDim2.new(0, 0, 0, 0)})
    task.delay(dur, function()
        if frame and frame.Parent then
            local tw = tween(frame, 0.2, {Position = UDim2.new(1, 340, 0, 0)})
            if tw then
                tw.Completed:Connect(function() frame:Destroy() end)
            else
                frame:Destroy()
            end
        end
    end)
end

