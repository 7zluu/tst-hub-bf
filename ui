local currentTab = nil
local function createTab(name)
    local tabButton = new("TextButton", {
        BackgroundColor3 = Theme.Colors.Card,
        TextColor3 = Theme.Colors.Text2,
        TextSize = 11,
        Font = Theme.Font,
        Text = name,
        Size = UDim2.new(1, 0, 0, 40),
        BorderSizePixel = 0,
        Parent = tabsContainer
    })
    corner(tabButton, 0)
    
    local tabContent = new("ScrollingFrame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        ScrollBarThickness = 6,
        Parent = contentContainer
    })
    new("UIListLayout", {Padding = UDim.new(0, 12), Parent = tabContent})
    new("UIPadding", {PaddingLeft = UDim.new(0, 15), PaddingRight = UDim.new(0, 15), PaddingTop = UDim.new(0, 15), Parent = tabContent})
    
    tabButton.MouseButton1Click:Connect(function()
        if currentTab then currentTab.Visible = false end
        tabContent.Visible = true
        currentTab = tabContent
        tabButton.BackgroundColor3 = Theme.Colors.CardHover
        for _, btn in pairs(tabsContainer:GetChildren()) do
            if btn:IsA("TextButton") and btn ~= tabButton then
                btn.BackgroundColor3 = Theme.Colors.Card
            end
        end
    end)
    
    local addToggle = function(text, default, callback)
        local container = new("Frame", {
            BackgroundColor3 = Theme.Colors.Card,
            Size = UDim2.new(1, 0, 0, 35),
            BorderSizePixel = 0,
            Parent = tabContent
        })
        corner(container, 6)
        
        local label = new("TextLabel", {
            BackgroundTransparency = 1,
            TextColor3 = Theme.Colors.Text,
            TextSize = 12,
            Font = Theme.Font,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = text,
            Size = UDim2.new(1, -50, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            Parent = container
        })
        
        local toggle = new("TextButton", {
            BackgroundColor3 = default and Theme.Colors.Success or Theme.Colors.Danger,
            TextColor3 = Theme.Colors.Text,
            TextSize = 10,
            Font = Theme.Font,
            Text = default and "ON" or "OFF",
            Size = UDim2.new(0, 40, 0, 20),
            Position = UDim2.new(1, -45, 0.5, -10),
            BorderSizePixel = 0,
            Parent = container
        })
        corner(toggle, 4)
        
        local state = default
        toggle.MouseButton1Click:Connect(function()
            state = not state
            toggle.BackgroundColor3 = state and Theme.Colors.Success or Theme.Colors.Danger
            toggle.Text = state and "ON" or "OFF"
            if callback then callback(state) end
        end)
    end
    
    local addButton = function(text, callback)
        local button = new("TextButton", {
            BackgroundColor3 = Theme.Colors.Card,
            TextColor3 = Theme.Colors.Text,
            TextSize = 12,
            Font = Theme.Font,
            Text = text,
            Size = UDim2.new(1, 0, 0, 35),
            BorderSizePixel = 0,
            Parent = tabContent
        })
        corner(button, 6)
        
        button.MouseButton1Click:Connect(function()
            if callback then callback() end
        end)
    end
    
    local addSlider = function(text, min, max, default, callback)
        local container = new("Frame", {
            BackgroundColor3 = Theme.Colors.Card,
            Size = UDim2.new(1, 0, 0, 50),
            BorderSizePixel = 0,
            Parent = tabContent
        })
        corner(container, 6)
        
        local label = new("TextLabel", {
            BackgroundTransparency = 1,
            TextColor3 = Theme.Colors.Text,
            TextSize = 11,
            Font = Theme.Font,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = text .. ": " .. tostring(default),
            Size = UDim2.new(1, 0, 0, 18),
            Position = UDim2.new(0, 10, 0, 5),
            Parent = container
        })
        
        local sliderBg = new("Frame", {
            BackgroundColor3 = Theme.Colors.Input,
            Size = UDim2.new(1, -20, 0, 6),
            Position = UDim2.new(0, 10, 0, 28),
            BorderSizePixel = 0,
            Parent = container
        })
        corner(sliderBg, 3)
        
        local sliderFill = new("Frame", {
            BackgroundColor3 = Theme.Colors.Success,
            Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
            BorderSizePixel = 0,
            Parent = sliderBg
        })
        corner(sliderFill, 3)
        
        local dragging = false
        sliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
            end
        end)
        
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        
        UIS.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local mouse = LP:GetMouse()
                local percentage = math.clamp((mouse.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
                local value = math.floor(min + (max - min) * percentage)
                sliderFill.Size = UDim2.new(percentage, 0, 1, 0)
                label.Text = text .. ": " .. tostring(value)
                if callback then callback(value) end
            end
        end)
    end
    
    return {
        AddToggle = addToggle,
        AddButton = addButton,
        AddSlider = addSlider
    }
end

