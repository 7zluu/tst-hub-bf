                local function set(v)
                    state = v
                    tween(track, 0.15, {BackgroundColor3 = state and Color3.fromRGB(255,255,255) or Theme.Colors.BorderLight})
                    tween(knob, 0.15, {
                        Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
                        BackgroundColor3 = state and Color3.fromRGB(0,0,0) or Color3.fromRGB(255,255,255)
                    })
                end
                btn.MouseButton1Click:Connect(function()
                    set(not state)
                    if cb then
                        local ok, err = pcall(cb, state)
                        if not ok then warn("[Ousaware] Toggle error: " .. tostring(err)) end
                    end
                end)
                if cb then pcall(cb, default) end
                return {Set = function(_, v) set(v) end, Get = function() return state end}
            end

            function g:AddSlider(opt)
                opt = opt or {}
                local text = opt.Text or opt.Title or "Slider"
                local mn = tonumber(opt.Min) or 0
                local mx = tonumber(opt.Max) or 100
                local default = tonumber(opt.Default) or mn
                local rounding = opt.Rounding
                local cb = opt.Callback
                local value = default

                local wrap = new("Frame", {
                    BackgroundColor3=Theme.Colors.Input, BorderSizePixel=0,
                    Size=UDim2.new(1, 0, 0, 52), Parent=gb
                })
                corner(wrap, 6); stroke(wrap)
                new("TextLabel", {
                    BackgroundTransparency=1, Font=Theme.Font, Text=tostring(text),
                    TextColor3=Theme.Colors.Text, TextSize=13,
                    TextXAlignment=Enum.TextXAlignment.Left,
                    Position=UDim2.new(0, 12, 0, 8), Size=UDim2.new(1, -80, 0, 16), Parent=wrap
                })
                local valBox = new("TextBox", {
                    BackgroundColor3=Theme.Colors.Card, BorderSizePixel=0,
                    Font=Theme.Font, Text=tostring(default),
                    TextColor3=Theme.Colors.Text, TextSize=12,
