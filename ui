                    BorderSizePixel = 0,
                    Position = UDim2.new(1, -280, 0, 40),
                    Size = UDim2.new(0, 280, 0, 0),
                    Visible = false,
                    ClipsDescendants = true,
                    ZIndex = 10,
                    Parent = wrap,
                })
                corner(popup, 6)
                stroke(popup, Theme.Colors.BorderLight, 1)
                local pl = new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = popup})
                new("UIPadding", {PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = popup})

                local r, g_, b = default.R * 255, default.G * 255, default.B * 255

                local function buildChannel(name, initial, setter)
                    local cw = new("Frame", {
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 0, 20),
                        Parent = popup,
                    })
                    new("TextLabel", {
                        BackgroundTransparency = 1,
                        Font = Theme.Font,
                        Text = name,
                        TextColor3 = Theme.Colors.Text2,
                        TextSize = 12,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Size = UDim2.new(0, 20, 1, 0),
                        Parent = cw,
                    })
                    local bar = new("Frame", {
                        BackgroundColor3 = Theme.Colors.BorderLight,
                        BorderSizePixel = 0,
                        Position = UDim2.new(0, 24, 0.5, -2),
                        Size = UDim2.new(1, -60, 0, 4),
                        Parent = cw,
                    })
                    corner(bar, 2)
                    local fillPct = initial / 255
                    local fill = new("Frame", {
                        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                        BorderSizePixel = 0,
                        Size = UDim2.new(fillPct, 0, 1, 0),
                        Parent = bar,
                    })
                    corner(fill, 2)
                    local hit = new("TextButton", {
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 4, 0),
                        Position = UDim2.new(0, 0, 0.5, 0),
                        AnchorPoint = Vector2.new(0, 0.5),
                        Text = "",
                        Parent = bar,
                    })
                    local val = new("TextLabel", {
                        BackgroundTransparency = 1,
                        Font = Theme.Font,
                        Text = tostring(math.floor(initial)),
                        TextColor3 = Theme.Colors.Text,
                        TextSize = 11,
                        Position = UDim2.new(1, -34, 0, 0),
                        Size = UDim2.new(0, 32, 1, 0),
                        Parent = cw,
                    })
                    local dragging = false
                    hit.MouseButton1Down:Connect(function() dragging = true end)
                    UIS.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                    end)
                    UIS.InputChanged:Connect(function(input)
                        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                            local p = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                            local v = math.floor(p * 255)
                            setter(v)
                            val.Text = tostring(v)
                            fill.Size = UDim2.new(p, 0, 1, 0)
                            preview.BackgroundColor3 = Color3.fromRGB(r, g_, b)
                            if cb then pcall(cb, Color3.fromRGB(r, g_, b)) end
                        end
                    end)
                end
                buildChannel("R", r, function(v) r = v end)
                buildChannel("G", g_, function(v) g_ = v end)
                buildChannel("B", b, function(v) b = v end)

                local toggleBtn = new("TextButton", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 1, 0),
                    Text = "",
                    Parent = wrap,
                })
                local opened = false
                toggleBtn.MouseButton1Click:Connect(function()
                    opened = not opened
                    popup.Visible = opened
                    popup.Size = UDim2.new(0, 280, 0, opened and 100 or 0)
                end)

                return {
                    SetValue = function(_, c) current = c; preview.BackgroundColor3 = c end,
                    GetValue = function() return preview.BackgroundColor3 end,
                }
            end

            -- ═══ AddKeybind ═══
            function g:AddKeybind(opt)
                opt = opt or {}
                local text = opt.Title or opt.Text or "Keybind"
                local default = opt.Default or "F"
                local cb = opt.Callback
                local currentKey = tostring(default)
                local picking = false

                local wrap = new("Frame", {
                    BackgroundColor3 = Theme.Colors.Input,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 36),
                    Parent = gb,
                })
                corner(wrap, 6)
                stroke(wrap, Theme.Colors.Border, 1)

                new("TextLabel", {
                    BackgroundTransparency = 1,
                    Font = Theme.Font,
                    Text = tostring(text),
                    TextColor3 = Theme.Colors.Text,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Position = UDim2.new(0, 12, 0, 0),
                    Size = UDim2.new(1, -80, 1, 0),
                    Parent = wrap,
                })

                local keyBox = new("TextButton", {
                    BackgroundColor3 = Theme.Colors.Card,
                    BorderSizePixel = 0,
                    Font = Theme.Font,
                    Text = currentKey,
                    TextColor3 = Theme.Colors.Text,
                    TextSize = 12,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.new(0, 55, 0, 22),
                    AutoButtonColor = false,
                    Parent = wrap,
                })
                corner(keyBox, 4)

                keyBox.MouseButton1Click:Connect(function()
                    if picking then return end
                    picking = true
                    keyBox.Text = "..."
                    task.wait(0.2)
                    local conn
                    conn = UIS.InputBegan:Connect(function(input)
                        if not picking then return end
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            currentKey = input.KeyCode.Name
                        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                            currentKey = "MouseLeft"
                        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                            currentKey = "MouseRight"
                        end
                        keyBox.Text = currentKey
                        picking = false
                        if conn then conn:Disconnect() end
                    end)
                end)

                UIS.InputBegan:Connect(function(input, gpe)
                    if gpe or picking then return end
                    local pressed
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        pressed = input.KeyCode.Name
                    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                        pressed = "MouseLeft"
                    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                        pressed = "MouseRight"
                    end
                    if pressed and pressed == currentKey and cb then
                        pcall(cb)
                    end
                end)

                return {
                    Set = function(_, k) currentKey = tostring(k); keyBox.Text = currentKey end,
                    Get = function() return currentKey end,
                }
            end

            return g
        end

